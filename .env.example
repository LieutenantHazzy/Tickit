# App
APP_ENV=prod
BIND_ADDR=127.0.0.1
# When run via docker compose this is overridden to 0.0.0.0 inside the container.
BIND_PORT=8081
APP_SECRET=change_me_long_random_64_characters_minimum
BASE_URL=http://10.0.0.1:8080
DEFAULT_LANG=en
DATA_DIR=/var/lib/tickit
DB_PATH=/var/lib/tickit/tickit.db

# Mail (Gmail app-password or Proton SMTP)
# Leave SMTP_HOST empty to disable all email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=app_password
MAIL_FROM="Tickit <your_email@gmail.com>"
MAIL_TO_ERRORS=your_email@gmail.com

# Auth
COOKIE_NAME=tickit_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_PER_5MIN=5
REGISTRATION_OPEN=true

# Reminders
DAILY_REMINDER_HOUR=7
DAILY_REMINDER_MIN=0
REMINDER_OFFSET_MIN=15

# Logging
LOG_LEVEL=info
